{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@zthxxx/tsconfig/tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "target": "esnext",
    "module": "ESNext",
    "noEmit": true,
    "declaration": true,
    "declarationMap": false,
    // https://www.typescriptlang.org/tsconfig/#moduleResolution
    "moduleResolution": "bundler",

    "types": [
      "node",
      "vitest/globals",
    ],
  },
  "include": [
    "src",
  ],
}
